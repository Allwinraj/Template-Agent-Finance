  {
    "workflow_id": "wf-0012",
    "name": "asdfsdf",
    "description": "Compare actual financial results with approved budget, calculate variances by account, entity, cost center, and period, flag material exceptions, and generate an evidence-backed management report.",
    "config": {
      "agents": [
        "A1",
        "A2",
        "A3",
        "A4",
        "A5",
        "A6"
      ],
      "sources": [
        {
          "role": "actuals",
          "file": "budget_actuals.csv",
          "field_mappings": {
            "Company Code": "company_code",
            "GL Account": "gl_account",
            "Cost Center": "cost_center",
            "Fiscal Period": "fiscal_period",
            "Amount": "amount"
          }
        },
        {
          "role": "budget",
          "file": "budget_plan.csv",
          "field_mappings": {
            "Company Code": "company_code",
            "GL Account": "gl_account",
            "Cost Center": "cost_center",
            "Fiscal Period": "fiscal_period",
            "Budget Amount": "amount"
          }
        }
      ],
      "comparison": {
        "left_role": "actuals",
        "right_role": "budget",
        "keys": [
          "company_code",
          "gl_account",
          "cost_center",
          "fiscal_period"
        ]
      },
      "calculations": [
        {
          "id": "variance",
          "calculator": "calculate_variance",
          "version": 1,
          "used_by": "A4",
          "scope": "row",
          "input_mapping": {
            "actual": "actuals.amount",
            "budget": "budget.amount"
          },
          "output_mapping": {
            "result": "results.variance"
          },
          "depends_on": []
        },
        {
          "id": "variance_pct",
          "calculator": "calculate_variance_percentage",
          "version": 1,
          "used_by": "A4",
          "scope": "row",
          "input_mapping": {
            "variance": "results.variance",
            "budget": "budget.amount"
          },
          "output_mapping": {
            "result": "results.variance_pct"
          },
          "depends_on": [
            "variance"
          ]
        },
        {
          "id": "materiality_flag",
          "calculator": "calculate_materiality",
          "version": 1,
          "used_by": "A4",
          "scope": "row",
          "input_mapping": {
            "variance": "results.variance",
            "threshold": "settings.materiality"
          },
          "output_mapping": {
            "result": "results.is_material"
          },
          "depends_on": [
            "variance"
          ]
        },
        {
          "id": "total_actuals",
          "calculator": "calculate_sum",
          "version": 1,
          "used_by": "A5",
          "scope": "global",
          "input_mapping": {
            "values": "actuals.amount"
          },
          "output_mapping": {
            "result": "results.total_actuals"
          },
          "depends_on": []
        },
        {
          "id": "total_budget",
          "calculator": "calculate_sum",
          "version": 1,
          "used_by": "A5",
          "scope": "global",
          "input_mapping": {
            "values": "budget.amount"
          },
          "output_mapping": {
            "result": "results.total_budget"
          },
          "depends_on": []
        },
        {
          "id": "total_variance",
          "calculator": "calculate_variance",
          "version": 1,
          "used_by": "A5",
          "scope": "global",
          "input_mapping": {
            "actual": "results.total_actuals",
            "budget": "results.total_budget"
          },
          "output_mapping": {
            "result": "results.total_variance"
          },
          "depends_on": [
            "total_actuals",
            "total_budget"
          ]
        },
        {
          "id": "material_exceptions_count",
          "calculator": "calculate_count",
          "version": 1,
          "used_by": "A5",
          "scope": "global",
          "input_mapping": {
            "values": "results.is_material"
          },
          "output_mapping": {
            "result": "results.material_exceptions_count"
          },
          "depends_on": [
            "materiality_flag"
          ]
        }
      ],
      "rules": [
        {
          "id": "required_keys",
          "version": 1,
          "params": {
            "fields": [
              "company_code",
              "gl_account",
              "cost_center",
              "fiscal_period"
            ]
          }
        },
        {
          "id": "material_variance_check",
          "version": 3,
          "params": {
            "threshold": "settings.materiality",
            "field": "results.variance"
          }
        },
        {
          "id": "duplicate_check",
          "version": 1,
          "params": {
            "keys": [
              "company_code",
              "gl_account",
              "cost_center",
              "fiscal_period"
            ]
          }
        }
      ],
      "settings": {
        "materiality": 3000,
        "on_track_pct": 5,
        "review_pct": 10
      },
      "output_spec": [
        {
          "id": "aligned_records",
          "title": "Aligned Actual and Budget Records",
          "render": "table",
          "description": "Side-by-side actual and budget amounts matched by company, account, cost center, and period with calculated variance and variance percentage",
          "source": "results"
        },
        {
          "id": "variance_analysis",
          "title": "Variance and Variance Percentage",
          "render": "table",
          "description": "Row-level variance (actual - budget) and variance percentage (variance / budget) for each account-entity-cost center-period combination",
          "source": "results"
        },
        {
          "id": "material_exceptions",
          "title": "Materiality Exceptions",
          "render": "exceptions",
          "description": "Records where absolute variance exceeds the materiality threshold, flagged for management review",
          "source": "results"
        },
        {
          "id": "management_report",
          "title": "Evidence-Backed Management Report",
          "render": "narrative",
          "description": "Executive summary with total actuals, total budget, overall variance, count of material exceptions, and top drivers by account and entity",
          "source": "results"
        }
      ],
      "routing": {
        "A1": [
          "actuals",
          "budget"
        ],
        "A2": [
          "A1"
        ],
        "A3": [
          "A2"
        ],
        "A4": [
          "A3"
        ],
        "A5": [
          "A4"
        ],
        "A6": [
          "A1",
          "A2",
          "A3",
          "A4",
          "A5"
        ]
      },
      "report": {
        "title": "Budget vs Actuals Variance Analysis Report",
        "audience": "Finance Management, Controllers, CFO",
        "output_spec": [
          {
            "id": "aligned_records",
            "title": "Aligned Actual and Budget Records",
            "render": "table",
            "description": "Side-by-side actual and budget amounts matched by company, account, cost center, and period with calculated variance and variance percentage",
            "source": "results"
          },
          {
            "id": "variance_analysis",
            "title": "Variance and Variance Percentage",
            "render": "table",
            "description": "Row-level variance (actual - budget) and variance percentage (variance / budget) for each account-entity-cost center-period combination",
            "source": "results"
          },
          {
            "id": "material_exceptions",
            "title": "Materiality Exceptions",
            "render": "exceptions",
            "description": "Records where absolute variance exceeds the materiality threshold, flagged for management review",
            "source": "results"
          },
          {
            "id": "management_report",
            "title": "Evidence-Backed Management Report",
            "render": "narrative",
            "description": "Executive summary with total actuals, total budget, overall variance, count of material exceptions, and top drivers by account and entity",
            "source": "results"
          }
        ]
      },
      "llm_provider": "openrouter",
      "calculation_policy": {
        "null_behavior": "create_exception",
        "blank_behavior": "create_exception",
        "zero_denominator": "create_exception",
        "rounding_mode": "half_even",
        "decimal_places": 2,
        "currency_mismatch": "stop_pipeline"
      }
    },
