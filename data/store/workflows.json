          "title": "Headline",
          "render": "kpi",
          "source": "summary",
          "description": "headline"
        },
        {
          "id": "rep",
          "title": "Report",
          "render": "narrative",
          "description": "management commentary"
        }
      ],
      "routing": {},
      "report": {
        "title": "Gl vs Forecast Report",
